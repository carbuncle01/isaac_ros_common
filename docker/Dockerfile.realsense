# Dockerfile for setting up Realsense driver
#  https://github.com/jetsonhacks/installRealSenseSDK
ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

# ==============================================================================
# Intel RealSense SDK Installation (Optimized)
# ==============================================================================

# 5. Intel RealSense公開キーを登録
RUN apt-key adv --keyserver keyserver.ubuntu.com --recv-key F6E65AC044F831AC80A06380C8B3A55A6F3EFCDE || \
    apt-key adv --keyserver hkp://keyserver.ubuntu.com:80 --recv-key F6E65AC044F831AC80A06380C8B3A55A6F3EFCDE

# 6. リポジトリを追加 & 7. RealSense SDKをインストール
RUN add-apt-repository "deb https://librealsense.intel.com/Debian/apt-repo $(lsb_release -cs) main" && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        librealsense2-utils \
        librealsense2-dev \
    # APTキャッシュもクリーンアップ
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/*
