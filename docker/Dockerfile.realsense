# Dockerfile for setting up RealSense driver
#   Reference: https://github.com/jetsonhacks/installRealSenseSDK
ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

# ==============================================================================
# Intel RealSense SDK Installation (Hardened + Modernized)
# ==============================================================================

# === 1. apt設定更新: Origin/Label変更を許可してIsaac ROSのapt更新エラーを回避 ===
RUN apt-get update --allow-releaseinfo-change --allow-releaseinfo-change-origin --allow-releaseinfo-change-label || true

# === 2. RealSense公開鍵を安全に登録（amd64のみ Intel apt を使用） ===
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl gnupg2 lsb-release ca-certificates && \
    if [ "$(dpkg --print-architecture)" = "amd64" ]; then \
      curl -fsSL https://librealsense.intel.com/Debian/librealsense.pgp | gpg --dearmor -o /usr/share/keyrings/librealsense.gpg && \
      echo "deb [signed-by=/usr/share/keyrings/librealsense.gpg] https://librealsense.intel.com/Debian/apt-repo $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/librealsense.list; \
    fi

# === 3. RealSense SDKインストール ===
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ros-humble-librealsense2 \
        ros-humble-realsense2-camera \
        ros-humble-realsense2-description && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/*
