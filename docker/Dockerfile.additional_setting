# ============================================================
# ベース: ISAAC ROS 基本イメージ
# ============================================================
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root
SHELL ["/bin/bash", "-c"]

# ============================================================
# 1. CycloneDDS 設定（頻繁に変えない → 上層でOK）
# ============================================================
COPY middleware_profiles/cyclonedds.xml /etc/cyclonedds.xml
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI=file:///etc/cyclonedds.xml
ENV ROS_DOMAIN_ID=50

# ============================================================
# 2. admin ユーザーの作成（キャッシュ安定・UID競合解消付き）
# ============================================================
ARG HOST_USER_UID=1000
ARG HOST_USER_GID=1000
RUN if id -nu $HOST_USER_UID >/dev/null 2>&1; then userdel -f $(id -nu $HOST_USER_UID); fi || true
RUN groupadd -f -g $HOST_USER_GID admin && \
    useradd -o -u $HOST_USER_UID -g $HOST_USER_GID -m -s /bin/bash admin && \
    echo "admin ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers.d/admin-nopasswd

# ============================================================
# 3. 作業ディレクトリ設定（キャッシュ安定）
# ============================================================
WORKDIR /workspaces


# ============================================================
# 4. ライブラリのインストール
# ============================================================
# JetRacer ライブラリのインストール
RUN set -x && \
    cd /tmp && \
    git clone https://github.com/NVIDIA-AI-IOT/jetracer.git && \
    cd jetracer && \
    python3 setup.py install && \
    pip3 install traitlets questionary jetson-gpio && \
    cd / && rm -rf /tmp/*

# 5. PyTorch & 基本Pythonパッケージのインストール
RUN pip install torch==2.8.0 torchvision==0.23.0
RUN pip install \
    "textual>=5.3.0,<6.0.0" \
    "rich>=13.0.0,<14.0.0" \
    "psutil>=6.0.0,<7.0.0" \
    "distro>=1.9.0,<2.0.0" \
    "numpy>=2.0.1,<3.0.0" \
    "lark-parser>=0.12.0,<0.13.0" \
    "transforms3d" \
    "opencv-python" \
    "tqdm" \
    "rosbags" \
    "omegaconf" \
    "hydra-core" \
    "tensorboard" \
    "flax" \
    "optax" \
    "gymnasium" \
    "onnx" \
    "onnxruntime"

RUN ln -s /usr/local/lib/python3.10/dist-packages/numpy/_core/include /usr/local/lib/python3.10/dist-packages/numpy/core/include

# ============================================================
# 5.6 Race Line (Global Trajectory Optimization) Setup (x86_64 only)
# ============================================================
RUN set -x && \
    if [ "$(uname -m)" = "x86_64" ]; then \
        pip install --no-cache-dir "matplotlib>=3.5,<4" "scipy>=1.8,<2" && \
        pip install --no-cache-dir "quadprog>=0.1.11" && \
        pip install --no-cache-dir "git+https://github.com/TUMFTM/trajectory_planning_helpers.git@master" --no-deps; \
    fi

# ============================================================
# 6. スクリプト配置（頻度中程度）
# ============================================================
COPY scripts/entrypoint_additions/*.sh /usr/local/bin/scripts/entrypoint_additions/
RUN chmod +x /usr/local/bin/scripts/entrypoint_additions/*.sh || true

# ============================================================
# 7. APT 関連
# ============================================================

# # --- ISAAC ROS (APT available subset only) ---
RUN apt-get update && \
    apt-get install -y \
        ros-humble-isaac-ros-apriltag \
        ros-humble-isaac-ros-benchmark \
        ros-humble-isaac-ros-common \
        ros-humble-isaac-ros-cumotion \
        ros-humble-isaac-ros-examples \
        ros-humble-isaac-ros-image-pipeline \
        ros-humble-isaac-ros-nitros \
        ros-humble-isaac-ros-nvblox \
        ros-humble-isaac-ros-visual-slam \
        ros-humble-isaac-ros-nova \
        ros-humble-isaac-ros-argus-camera \
    && rm -rf /var/lib/apt/lists/*
    
# --- ROS 関連 ---
RUN apt-get update && \
    apt-get install -y \
        ros-humble-ackermann-msgs \
        ros-humble-laser-filters \
        ros-humble-laser-proc \
        ros-humble-camera-info-manager \
        ros-humble-cartographer \
        ros-humble-cartographer-ros \ 
        ros-humble-cartographer-rviz \
        ros-humble-gxf-isaac-ros-cuda \
        ros-humble-gxf-isaac-localization \
        ros-humble-isaac-ros-test \
        ros-humble-gxf-isaac-cuda \
        ros-humble-gxf-isaac-flatscan-localization \
        ros-humble-rqt-tf-tree \
        ros-humble-tf2-tools \
        ros-humble-image-transport-plugins \
    && rm -rf /var/lib/apt/lists/*

# --- 基本ユーティリティ ---
RUN apt-get update && \
    apt-get install -y \
        tmux \
        iproute2 \
        terminator \
        vim \
        htop \
        can-utils \
        bluez \
        joystick \
        git \
        sshpass \
        dialog \
        curl \
        wget \
        net-tools \
        tree \
    && rm -rf /var/lib/apt/lists/*

